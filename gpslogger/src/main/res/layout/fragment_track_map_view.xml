<?xml version="1.0" encoding="utf-8"?>
<!--
  Travel/hiking 改造：「轨迹地图」视图布局。
  - 顶部工具栏：刷新 / 定位最新点 / 适应轨迹边界图标按钮 + 缓存视野开关
  - 中部 MapLibre MapView 占据剩余空间
  - 底部一行图例/状态文案
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="55dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/track_map_btn_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tracker_track_map_refresh"
            android:padding="12dp"
            android:scaleType="center"
            android:src="@drawable/ic_track_map_refresh"
            android:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/track_map_btn_locate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tracker_track_map_locate"
            android:padding="12dp"
            android:scaleType="center"
            android:src="@drawable/ic_track_map_latest"
            android:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/track_map_btn_fit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tracker_track_map_fit"
            android:padding="12dp"
            android:scaleType="center"
            android:src="@drawable/ic_track_map_fit_bounds"
            android:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/track_map_btn_layer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tracker_track_map_layer"
            android:padding="12dp"
            android:scaleType="center"
            android:src="@drawable/ic_track_map_layers"
            android:tint="?attr/colorControlNormal" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/track_map_switch_cache_visible_tiles"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="@string/tracker_track_map_cache_visible_tiles" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/track_map_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/track_map_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:background="#88000000"
            android:padding="6dp"
            android:textColor="#FFFFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/track_map_legend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

</LinearLayout>
