<?xml version="1.0" encoding="utf-8"?>
<!--
  Travel/hiking 改造：「轨迹地图」视图布局。
  - 顶部一行按钮：刷新 / 定位最新点 / 适应轨迹边界
  - 中部 MapLibre MapView 占据剩余空间
  - 底部一行图例/状态文案
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="55dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/track_map_btn_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tracker_track_map_refresh" />

        <Button
            android:id="@+id/track_map_btn_locate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tracker_track_map_locate" />

        <Button
            android:id="@+id/track_map_btn_fit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tracker_track_map_fit" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/track_map_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/track_map_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:background="#88000000"
            android:padding="6dp"
            android:textColor="#FFFFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/track_map_legend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

</LinearLayout>
